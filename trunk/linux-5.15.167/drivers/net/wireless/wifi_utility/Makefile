# MediaTek mt_wifi utility glue (MTD / PCIe RBUS access)
# Built only when the closed source MTK WiFi driver is selected.
#
# Force obj-y: this directory is linked into vmlinux even when
# CONFIG_MT_AP_SUPPORT=m.  See the comment in ../Makefile for why.
obj-y += mt_wifi_mtd.o
obj-y += pci_mediatek_rbus.o
